# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_USER=plugdrop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plugdrop
# Used when running the API outside Docker:
DATABASE_URL=postgresql+psycopg://plugdrop:change-me@localhost:5432/plugdrop

# --- API ---
ENVIRONMENT=development            # set to "production" in production
JWT_SECRET=replace-with-64-random-characters   # python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=480
COOKIE_SECURE=false                # true behind HTTPS
CORS_ORIGINS=http://localhost:3000

# Password for the three seeded users (admin/manager/rep @plugdrop.example).
# Required when ENVIRONMENT=production.
SEED_PASSWORD=

# --- Integrations (optional; Settings shows only whether each is configured) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
VOICE_AI_API_KEY=
WHATSAPP_API_TOKEN=
CALENDAR_API_KEY=

# --- Stage 2: AI prospect research agent ---
RESEARCH_PROVIDER=mock               # research source; "mock" = fictional demo data for *.example institutions only
RESEARCH_REASONER=auto               # auto = Claude when ANTHROPIC_API_KEY is set, otherwise rule-based
RESEARCH_WORKER=embedded             # embedded | external (run: python -m app.research.worker) | off
RESEARCH_MAX_ATTEMPTS=3
RESEARCH_RETRY_BASE_SECONDS=30       # back-off doubles each attempt
RESEARCH_PROVIDER_RATE_PER_MINUTE=30
RESEARCH_DAILY_BUDGET_USD=5
RESEARCH_MAX_ITEMS_PER_JOB=100
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to your contracted prices so cost tracking is accurate (USD per million tokens):
ANTHROPIC_INPUT_USD_PER_MTOK=3
ANTHROPIC_OUTPUT_USD_PER_MTOK=15

# --- Stage 3: AI outreach agent ---
OUTREACH_WRITER=auto                     # auto = Claude when ANTHROPIC_API_KEY is set, otherwise rule-based templates
OUTREACH_WORKER=embedded                 # embedded | external | off  (sends scheduled emails, syncs replies every 15 s)
OUTREACH_MOCK_PROVIDER_ENABLED=true      # test mailbox: nothing leaves the system. Set false in production.
# Master switch. While false, real Gmail/Outlook mailboxes can only create drafts, whatever the admin policy says.
# Turn on only after mailboxes are configured, approved and tested.
OUTREACH_EXTERNAL_SENDING_ALLOWED=false
# Encrypts mailbox sign-in tokens at rest. Required before connecting Gmail/Outlook. Keep it secret and backed up.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000   # public address of the web app (used for OAuth callbacks)
# Google Workspace (Gmail API): create an OAuth client in Google Cloud; redirect URI
#   {OAUTH_REDIRECT_BASE_URL}/api/outreach/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft 365 (Graph API): register an app in Entra ID; redirect URI
#   {OAUTH_REDIRECT_BASE_URL}/api/outreach/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations

# --- Stage 4: WhatsApp, calendars, coordinated engagement ---
ENGAGEMENT_WORKER=embedded               # embedded | external (python -m app.engagement.worker) | off — sends queued WhatsApp, runs follow-up rules
WHATSAPP_PROVIDER=mock                   # mock (nothing leaves the system) | meta (official WhatsApp Business Platform Cloud API)
# Master switch, like email: while false the real WhatsApp provider never sends, whatever the admin policy says.
WHATSAPP_EXTERNAL_SENDING_ALLOWED=false
WHATSAPP_PHONE_NUMBER_ID=                # from Meta Business Manager → WhatsApp → API setup
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=                   # a System User token with whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_APP_SECRET=                     # verifies webhook signatures (X-Hub-Signature-256)
WHATSAPP_VERIFY_TOKEN=                   # any long random text; enter the same value in Meta's webhook settings
CALENDAR_MOCK_ENABLED=true               # test calendars for demos; set false in production
# Google / Microsoft calendars reuse GOOGLE_CLIENT_ID/SECRET and MICROSOFT_CLIENT_ID/SECRET above. Add redirect URIs:
#   {OAUTH_REDIRECT_BASE_URL}/api/meetings/oauth/google/callback
#   {OAUTH_REDIRECT_BASE_URL}/api/meetings/oauth/microsoft/callback
