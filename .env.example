# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_USER=plugdrop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plugdrop
# Used when running the API outside Docker:
DATABASE_URL=postgresql+psycopg://plugdrop:change-me@localhost:5432/plugdrop

# --- API ---
ENVIRONMENT=development            # set to "production" in production
JWT_SECRET=replace-with-64-random-characters   # python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=480
COOKIE_SECURE=false                # true behind HTTPS
CORS_ORIGINS=http://localhost:3000

# Password for the three seeded users (admin/manager/rep @plugdrop.example).
# Required when ENVIRONMENT=production.
SEED_PASSWORD=

# --- Integrations (optional; Settings shows only whether each is configured) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
VOICE_AI_API_KEY=
WHATSAPP_API_TOKEN=
CALENDAR_API_KEY=

# --- Stage 2: AI prospect research agent ---
RESEARCH_PROVIDER=mock               # research source; "mock" = fictional demo data for *.example institutions only
RESEARCH_REASONER=auto               # auto = Claude when ANTHROPIC_API_KEY is set, otherwise rule-based
RESEARCH_WORKER=embedded             # embedded | external (run: python -m app.research.worker) | off
RESEARCH_MAX_ATTEMPTS=3
RESEARCH_RETRY_BASE_SECONDS=30       # back-off doubles each attempt
RESEARCH_PROVIDER_RATE_PER_MINUTE=30
RESEARCH_DAILY_BUDGET_USD=5
RESEARCH_MAX_ITEMS_PER_JOB=100
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to your contracted prices so cost tracking is accurate (USD per million tokens):
ANTHROPIC_INPUT_USD_PER_MTOK=3
ANTHROPIC_OUTPUT_USD_PER_MTOK=15
